# Janus — capability order: (1) ping, (2) control, (3) hub, (4) mdns, (5) auth, (6) files, (7) sendfile, (8) browse, (9) access log, (10) webtransport, (11) vista
#
# *.janus.localhost resolves to the loopback with no DNS; Caddy's internal CA
# issues every site certificate (skip_install_trust: run `./bin/janus trust`
# once, or pass curl --cacert <data>/caddy/pki/authorities/local/root.crt).
#
#   ./bin/janus run
#
# 1) ping — primordial; needs nothing else
#   Global ping ON.
#   catchall  *.janus.localhost     → inherit on  → pong
#   on.janus.localhost              → explicit on → pong
#   off.janus.localhost             → explicit off → 404
#
#   curl -s https://foo.janus.localhost/ping                                   → pong
#   curl -s https://on.janus.localhost/ping                                    → pong
#   curl -s https://off.janus.localhost/ping -o /dev/null -w '%{http_code}\n'  → 404
#
# 2) control — process-wide /1.0 (after ping chassis)
#   internal → unix  run/janus.sock
#   local    → http  127.0.0.1:7600
#
#   curl -s http://127.0.0.1:7600/1.0
#   curl -s http://127.0.0.1:7600/1.0/health
#   curl -s --unix-socket run/janus.sock http://janus/1.0
#
# on-demand tls (hot ask via /1.0) — minting gated by the registry
#   Cold config owns the machinery (on_demand_tls global + per-site
#   tls { on_demand }); the registry only answers "may we mint for
#   this name?" — in-process as `permission janus`, and over the control
#   API as GET /1.0/tls/ask?domain=… (200 allow, 404 deny). The :8443
#   site below mints from Caddy's internal CA on demand: registered
#   hosts complete the handshake, unknown names are denied.
#
#   curl -s 'http://127.0.0.1:7600/1.0/tls/ask?domain=some.host'  → 404 until registered
#
# 3) hub — per-app WebSocket fan-out (site-scoped, cascades)
#   Global hub ON (path /hub, origin same): upgrades on registered hosts
#   terminate at Janus; frames fan out at the edge; the tenant observes
#   through its hot-registered bridge and steers via
#   POST /1.0/apps/{id}/hub/publish.
#   catchall   *.janus.localhost   → inherit on (default tuning, origin same)
#   api.janus.localhost            → explicit off (plain HTTP API site)
#   hubany.janus.localhost         → origin any (token-authenticated non-browser clients)
#   hubdirect.janus.localhost      → direct mode: no worker bridge, empty upstreams legal
#   hubten/hubtwenty         → max_conns 10 / 20 (per-app floor = 10 when
#                              one app claims both)
#
#   curl -s http://127.0.0.1:7600/1.0/hub          → hub counters
#
# 4) mdns — LAN presence (process-wide, like control)
#   Enabling announces this machine and its app list to the local
#   network, and serves the read-only status front door on every
#   interface. janus.local + every registered single-label .local host
#   advertise over multicast DNS; the front door renders the registry,
#   registry and hub state at a glance. listen :7680 pins dedicated mode here so
#   the dev config (and ./test.sh) runs unprivileged; the production
#   default (no listen) is shared mode — the front door rides inside
#   the :80 HTTP server behind an http://*.local site block (see
#   Caddyfile.example).
#
#   curl -s http://127.0.0.1:7600/1.0/mdns             → advertiser state
#   curl -s -H 'Host: janus.local' http://127.0.0.1:7680/status.json
#
# 5) auth — URL-prefix gates for auth-less apps (site-scoped, cascades)
#   Global auth ON with fixture users + gates (passwords in the block
#   below; mint with `./bin/janus passhash`). Every site EXCEPT
#   authwall/authcarol opts out with `auth off`. Cascade:
#   authwall.janus.localhost   → inherits global users + gates
#   authcarol.janus.localhost  → site auth { … } replaces global (carol only)
#   everything else      → explicit off beats inherited on
#
#   curl -s https://authwall.janus.localhost/auth                 → gate / login
#   curl -s https://authwall.janus.localhost/one/auth             → gate /one/ login
#   curl -s http://127.0.0.1:7600/1.0/auth                  → counters + sessions
#
{
	auto_https disable_redirects # the redirect server would bind :80; this dev/CI config runs unprivileged
	skip_install_trust

	servers {
		protocols h1 h2 # HTTP/3 would bind the webtransport relay's UDP port
	}

	on_demand_tls {
		permission janus
	}

	janus {
		ping # 1) site-scoped default: on
		control internal {$JANUS_TEST_CONTROL:run/janus.sock} # 2) process-wide
		control local
		heartbeat_ttl {$JANUS_HEARTBEAT_TTL:15s}
		hub # 3) site-scoped default: on (path /hub, origin same)
		webtransport # 10) process-wide relay listener on UDP 443; routes are per site
		mdns {
			# 4) process-wide LAN presence
			listen :7680 # dedicated dev/test listener; default (no listen) shares the :80 HTTP server
		}
		auth {
			# 5) site-scoped default: on — fixture credentials (committed on purpose)
			users {
				alice aZoyWD0mfNZH7GZCh3DH9Te1FwAxA0yc # password: sesame-alice
				bob aI9eoj7z2M0oTFWY3ai7uQzblQR2spHF # password: sesame-bob
				larry aTsNAccM4EGpfEd4HaZMzNc4KJ63yeD1 # password: sesame-larry
			}
			ttl 8h # host-wide sliding idle (default)
			gate / {
				# whole site; login door /auth
				alice bob
			}
			gate /one/ {
				# longer prefix wins under /one/
				alice larry
			}
		}
		files {
			# 6) site-scoped default: on; hot registrations carry roots and shell
			precompressed # transparent .br, .zst, .gz sidecars in Caddy preference order
		}
		browse {
			# 8) navigable roots; embedded theme + bounded fixture renderers
			timeout 10s
			max_output 8MB
			concurrency 4
			renderer .md {
				command cat {file}
				content_type "text/plain; charset=utf-8"
			}
			renderer .hold {
				command /bin/sh -c "sleep 1; cat \"$1\"" janus {file}
				content_type "text/plain; charset=utf-8"
				timeout 3s
				concurrency 1
			}
			renderer .slow {
				command /bin/sh -c "sleep 2; cat \"$1\"" janus {file}
				content_type "text/plain; charset=utf-8"
				timeout 100ms
			}
			renderer .fail {
				command /usr/bin/false {file}
				content_type "text/plain; charset=utf-8"
			}
		}
	}
}

(janus_access) {
	log {
		output file {$JANUS_TEST_ACCESS_LOG:.test-access.log}
		format janus {
			time_format rfc3339_nano
			duration_format seconds
		}
	}
}

# Catchall — any other *.janus.localhost name inherits global ping on
# (auth off: the acceptance suite drives open sites through this block;
# authwall/authcarol below are the guarded ones)
*.janus.localhost {
	import janus_access
	janus {
		auth off
	}
}

# Explicit on (same effective result as catchall; proves site-level on)
on.janus.localhost {
	import janus_access
	janus {
		ping on
		auth off
	}
}

# Explicit off
off.janus.localhost {
	import janus_access
	janus {
		ping off
		auth off
	}
}

# Hub: explicit off beats inherited on for this plain HTTP API site.
api.janus.localhost {
	import janus_access
	janus {
		hub off
		auth off
		files off
		browse off
	}
}

# Files: explicit off beats the inherited global on.
filesoff.janus.localhost {
	import janus_access
	janus {
		auth off
		files off
		browse off
	}
}

# Files: Caddy's dynamic encode wrapper is deliberately present too. A
# selected precompressed representation already carries Content-Encoding,
# so the wrapper must never compress it a second time.
filesencode.janus.localhost {
	import janus_access
	encode {
		gzip
		minimum_length 1
	}
	janus {
		auth off
	}
}

# Browse: explicit off beats the inherited global default while files stay on.
browseoff.janus.localhost {
	import janus_access
	janus {
		auth off
		browse off
	}
}

# Browse: persistent exact-host root, outside the hot app registry.
coldbrowse.janus.localhost {
	import janus_access
	janus {
		auth off
		browse {
			root {$JANUS_BROWSE_COLD_ROOT:/tmp/janus-browse-cold}
		}
	}
}

# Hub: origin any — token-authenticated non-browser clients (and test
# drivers) that send no Origin header
hubany.janus.localhost {
	import janus_access
	janus {
		hub {
			origin any
		}
		auth off
	}
}

# Hub: direct edge transport — origin/auth/caps stay active; no worker bridge.
hubdirect.janus.localhost {
	import janus_access
	janus {
		hub {
			mode direct
			origin any
		}
		auth off
	}
}

# Hub: tightly capped sites — one app claiming both is floored at 10
hubten.janus.localhost {
	import janus_access
	janus {
		hub {
			max_conns 10
			origin any
		}
		auth off
	}
}

hubtwenty.janus.localhost {
	import janus_access
	janus {
		hub {
			max_conns 20
			origin any
		}
		auth off
	}
}

# Auth: inherits global users + gates (replace-not-merge only when the
# site writes its own auth { … } block). Bare janus → whole-site gate /
# plus /one/; login doors /auth and /one/auth.
authwall.janus.localhost {
	import janus_access
	# Nested host matchers intersect the exact site's admission.
	@nested host *.janus.localhost
	handle @nested {
		janus
	}
}

# Auth: site auth { … } replaces global (carol only, gate /, ttl 30m).
authcarol.janus.localhost {
	import janus_access
	janus {
		auth {
			users {
				carol a2infRCHPI6UisLSzkAdpHl3QMwRUeCF # password: sesame-carol
			}
			ttl 30m
			gate / {
				carol
			}
		}
	}
}

# On-demand TLS — certs minted per SNI from the internal CA, but only
# for names the registry allows (see on_demand_tls ask above).
# Hub off: this catch-all site would otherwise make EVERY host
# hub-enabled, defeating per-host hub admission. Auth off: a global
# wall inherited by an on-demand catch-all would wall every unknown
# host — opt catchalls out explicitly.
https://:8443 {
	import janus_access
	tls {
		on_demand
		issuer internal
	}
	janus {
		hub off
		auth off
	}
}

# 10) webtransport: a relay route on an exact-host site; the suite's UDP
# echo fixture stands in for a UDP application.
wt.janus.localhost {
	import janus_access
	janus {
		auth off # the plain relay; wtgate.janus.localhost below keeps the cascaded gate
		webtransport /relay udp/127.0.0.1:7690
	}
}

# The same route behind the cascaded auth gate: the descriptor is served
# to a signed-in user with a ticket the relay requires.
wtgate.janus.localhost {
	import janus_access
	janus {
		webtransport /relay udp/127.0.0.1:7690
	}
}

# 11) vista: VistA's RPC Broker behind POST /rpc; the suite's fake em stands
# in for em. The route lies under the global gate /, so it states its
# stance: VistA's sign-on authenticates its sessions.
vista.janus.localhost {
	import janus_access
	janus {
		vista /rpc unix/{$JANUS_TEST_VISTA_SOCK:/tmp/janus-vista.sock} {
			max_unsigned 4
			signon_timeout 10s
			auth exempt
		}
	}
}
